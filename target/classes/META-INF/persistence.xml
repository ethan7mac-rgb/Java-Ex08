<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="default">
        <class>ITSD.Entity.MenuItem</class>
        <class>ITSD.Entity.MenuCategory</class>
        <class>ITSD.Entity.Customer</class>
        <class>ITSD.Entity.CustomerOrder</class>
        <class>ITSD.Entity.OrderItem</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/RestaurantDB"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="JavaApp"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="JavaApp"/>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name = "hibernate.show_sql"
                      value = "true" />
        </properties>
    </persistence-unit>
</persistence>
